{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout -- a standalone fork should override them
 ;; with git coordinates. `site-prep.store` uses `langchain-store.core`
 ;; for the shared EDN-blob codec / identity-schema / entity field-spec
 ;; machinery (ADR-2607141600) instead of hand-rolling it. `site-prep.
 ;; notify`'s real Resend/Twilio transports use only `java.net.http` + a
 ;; hand-rolled minimal JSON/form encoder (see ns docstring) -- no extra
 ;; HTTP/JSON library dependency. This actor is COORDINATION-ONLY (every
 ;; proposal effect is `:propose`) -- it deliberately has NO dependency on
 ;; `kotoba-lang/robotics` or `kotoba-lang/physics-2d`: it never simulates
 ;; or dispatches excavation/earth-moving-equipment actions, only
 ;; proposes, schedules, flags and logs, all governor- and human-gated
 ;; (see README).
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "site-prep.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor stack
  ;; (site-prep.operation -> .governor -> .store) and rendering its
  ;; append-only ledger. `jp-go-digital-design-system` (デジタル庁デザイン
  ;; システム, the workspace's base design system) is a BUILD-TIME dependency
  ;; of the renderer ONLY -- the actor itself never needs it, so it lives in
  ;; this alias rather than in :deps. `:git/sha` (not :local/root) so a
  ;; standalone fork outside the monorepo can still regenerate the page.
  :render-html
  {:extra-deps {io.github.kotoba-lang/jp-go-digital-design-system
                {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
                 :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
   :main-opts  ["-m" "site-prep.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
